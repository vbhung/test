# ─────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local` — it is gitignored.
# ─────────────────────────────────────────────────────────

# ── Public (exposed to the browser) ──────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost
APP_PUBLIC_ORIGIN=http://localhost:3000

# Set to true only when a reverse proxy rewrites X-Forwarded-* headers
TRUSTED_PROXY_HEADERS=false

# Supabase — https://supabase.com/dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ── Server only (never expose these) ─────────────────────
# Supabase secret key (bypasses RLS — backend only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key
CF_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Must be at least 32 hex characters
TOKEN_MASTER_SECRET=generate_a_random_64_hex_string
EMERGENCY_ADMIN_KEY=generate_a_random_string

# Comma-separated hostnames allowed for Turnstile verification
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# ── Redis (Upstash REST) ─────────────────────────────────
# Optional in development — falls back to in-memory store.
# Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CPX Research surveys (optional) ──────────────────────
CPX_APP_ID=
CPX_SECURE_HASH=
CPX_POSTBACK_SECRET=
CPX_USD_TO_CAM_RATE=0
CPX_MAX_CAM_REWARD=100

# ── AdGem offerwall (optional) ───────────────────────────
ADGEM_POSTBACK_KEY=
ADGEM_POSTBACK_ENABLE_CREDIT=false
ADGEM_MAX_CAM_REWARD=10000

# ── Battleship minigame worker (optional) ────────────────
NEXT_PUBLIC_BATTLESHIP_WORKER_URL=
BATTLESHIP_INTEGRATION_SECRET=
BATTLESHIP_PARTNER_ID=
